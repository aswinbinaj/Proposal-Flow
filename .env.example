# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Supabase Service Role Key (used for administrative server-side operations if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Base URL (defaults to localhost:3000 in development, update with your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
